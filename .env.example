# Espalha Brasas local defaults — copy to .env or export before running
SPEAKAPP_BIND=0.0.0.0:8080
DATABASE_URL=sqlite://data/speakapp.db?mode=rwc
# Use a long random secret in production (≥32 chars). With SPEAKAPP_ENV=production,
# weak/default secrets refuse to start unless SPEAKAPP_ALLOW_INSECURE_SECRETS=1.
JWT_SECRET=dev-secret-change-me-in-production
# SPEAKAPP_ENV=production
MEDIA_DIR=data/media
PUBLIC_URL=http://127.0.0.1:8080
# Optional extra browser origins (comma-separated), plus localhost + PUBLIC_URL
# CORS_ORIGINS=https://app.example.com
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=espalha_brasas_dev_livekit_secret_32b
MAX_UPLOAD_BYTES=26214400
# Desktop (Vite / Electron) — set when building against a remote API:
# VITE_API_BASE=https://your.domain

