# Copied to deploy/.env by remote-deploy.sh (or manually for local Docker).
# Leave blank / omit to keep localhost defaults from docker-compose.yml.

JWT_SECRET=dev-secret-change-me-in-production
PUBLIC_URL=http://127.0.0.1:8080
# Token URL the desktop app uses. Local Docker: ws://127.0.0.1:7880
# Oracle / production: wss://livekit.your.domain (not ws://livekit:7880).
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=espalha_brasas_dev_livekit_secret_32b
MAX_UPLOAD_BYTES=26214400

# Production example (set these as GitHub Actions secrets — they land on the VPS):
# JWT_SECRET=long-random-string
# PUBLIC_URL=https://your.domain
# LIVEKIT_URL=wss://livekit.your.domain
# LIVEKIT_API_KEY=your-livekit-key
# LIVEKIT_API_SECRET=must-be-at-least-32-characters-long
